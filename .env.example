# Ya-TG 0.3.0 · 请勿把本文件填入真实凭证后提交
WEB_BIND=0.0.0.0
WEB_PORT=8787
ADMIN_PASSWORD=请设置强密码
APP_SECRET=请替换为至少32位随机字符串（用于 Token/Bot Token 加密，勿随意更换）

# ---------- 光鸭官方 OpenAPI（文件列表、用户信息） ----------
GUANGYA_CLIENT_ID=
# 以下两项仅用于从旧配置一次性导入 Token；正式运行请在管理后台完成授权
GUANGYA_ACCESS_TOKEN=
GUANGYA_REFRESH_TOKEN=
# Device Code 授权所需；sign_secret 只在后端使用，切勿写入前端或提交 Git
GUANGYA_PROJECT_ID=
GUANGYA_SIGN_SECRET=
GUANGYA_DEVICE_ID=ya-tg
# Web PKCE 回调地址，须与光鸭开放平台登记完全一致
GUANGYA_OAUTH_REDIRECT_URI=
GUANGYA_API_BASE=https://openapi.guangyapan.com
GUANGYA_ACCOUNT_BASE=https://openapi-account.guangyapan.com
GUANGYA_WWW_BASE=https://www.guangyapan.com

# ---------- 网页端分享接口（抓包适配，非公开 OpenAPI） ----------
# 请在 NAS 本机填写新会话凭证，不要粘贴到聊天或提交 Git
GUANGYA_SHARE_AUTHORIZATION=
GUANGYA_SHARE_DID=
GUANGYA_SHARE_DT=4
GUANGYA_SHARE_SMID=
GUANGYA_SHARE_BASE=https://api.guangyapan.com

# 自动建分享：0=永久 / 86400=1天 / 604800=7天 / 2592000=30天
AUTO_CREATE_SHARE=true
SHARE_DURATION=0
QUEUE_BACKOFF_BASE=60
QUEUE_BACKOFF_MAX=3600

# ---------- TMDB ----------
# 二选一，优先 TMDB_BEARER_TOKEN（v4 read access token）
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_LANGUAGE=zh-CN

SCAN_CRON=*/30 * * * *
SCAN_ROOT_ID=

# GitHub Actions 云端构建推送 DockerHub 使用（在本机 .env 中不需要）
DOCKERHUB_USERNAME=
DOCKERHUB_IMAGE=ya-tg
