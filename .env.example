# ============================================================
# Ya-TG 配置文件
# 用法：复制为 .env，改完保存，执行 docker compose up -d
# 警告：本文件含密码和令牌，不要提交 Git、不要发给别人
# ============================================================

# ---------- 部署设置 ----------
# 镜像版本：留空=最新版 latest；锁定历史版本请填版本号，例如 v0.3.0
IMAGE_TAG=
# 网页端口，被占用可改，例如 8899
WEB_PORT=8787
WEB_BIND=0.0.0.0

# ---------- 必填 ----------
# 管理后台登录密码，改成强密码
ADMIN_PASSWORD=请设置强密码
# 加密主密钥，用 openssl rand -hex 32 生成；改了要重新授权和重新添加 Bot
APP_SECRET=请替换为至少32位随机字符串

# ---------- 光鸭官方 OpenAPI（扫描、用户信息） ----------
# 开放平台分配的应用 ID
GUANGYA_CLIENT_ID=
# Device 授权用：项目 ID 与签名密钥（sign_secret 仅后端使用）
GUANGYA_PROJECT_ID=
GUANGYA_SIGN_SECRET=
GUANGYA_DEVICE_ID=ya-tg
# Web PKCE 授权用：回调地址，必须与平台登记一致
GUANGYA_OAUTH_REDIRECT_URI=
GUANGYA_API_BASE=https://openapi.guangyapan.com
GUANGYA_ACCOUNT_BASE=https://openapi-account.guangyapan.com
GUANGYA_WWW_BASE=https://www.guangyapan.com

# ---------- 光鸭网页分享会话（自动建分享用，非官方 OpenAPI） ----------
# 从浏览器抓包获取，会过期；请在 NAS 本机填写，不要外传
GUANGYA_SHARE_AUTHORIZATION=
GUANGYA_SHARE_DID=
GUANGYA_SHARE_DT=4
GUANGYA_SHARE_SMID=
GUANGYA_SHARE_BASE=https://api.guangyapan.com

# ---------- 分享策略 ----------
# true=推送前自动创建分享；false=需手动在资源库创建
AUTO_CREATE_SHARE=true
# 0=永久 / 86400=1天 / 604800=7天 / 2592000=30天
SHARE_DURATION=0
QUEUE_BACKOFF_BASE=60
QUEUE_BACKOFF_MAX=3600

# ---------- TMDB（海报与简介） ----------
# v4 read access token（推荐）与 v3 api key 二选一
TMDB_BEARER_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# ---------- 扫描计划 ----------
# 五段 Cron，北京时间。默认每 30 分钟
SCAN_CRON=*/30 * * * *
# 扫描根目录 ID；留空=全盘。测试时建议先填一个小目录
SCAN_ROOT_ID=
