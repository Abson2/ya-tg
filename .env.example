# ============================================================
# Ya-TG 配置文件
# 用法：复制为 .env，只需修改下面【必填】的两项，然后执行 docker compose up -d
# 光鸭账号不用在这里配置：部署好后打开管理网页，用手机号+短信验证码登录即可。
# 警告：本文件含密码，不要提交 Git、不要发给别人
# ============================================================

# ---------- 【必填】只改这两项就能跑 ----------
# 管理后台登录密码，改成你自己的强密码
ADMIN_PASSWORD=请设置强密码
# 加密主密钥，用 openssl rand -hex 32 生成（32 位以上随机字符串）
APP_SECRET=请替换为至少32位随机字符串

# ---------- 部署设置（一般保持默认） ----------
# 镜像版本：留空=最新版 latest；锁定历史版本请填版本号，例如 v0.7.0
IMAGE_TAG=
# 网页端口，被占用可改，例如 8899
WEB_PORT=8787
WEB_BIND=0.0.0.0

# ---------- 分享策略（一般保持默认） ----------
# true=推送前自动创建分享；false=需手动在资源库创建
AUTO_CREATE_SHARE=true
# 0=永久 / 86400=1天 / 604800=7天 / 2592000=30天
SHARE_DURATION=0
QUEUE_BACKOFF_BASE=60
QUEUE_BACKOFF_MAX=3600

# ---------- TMDB（海报与简介，可选） ----------
# 推荐部署后在管理页「TMDB 设置」里填密钥，无需改这里、无需重启，密钥加密保存。
# 同一页还可配置「AI 辅助识别」（任意 OpenAI 兼容服务），同样不用改 .env。
# 下面留空即可；只有想用 .env 预置时才填。v4 token（eyJ...）与 v3 key（32位hex）二选一，
# 系统会自动按格式判断类型。不配置也能正常扫描/建分享/推送，只是没有海报简介。
TMDB_BEARER_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# ---------- 扫描计划（可选） ----------
# 五段 Cron，北京时间。默认每 30 分钟
SCAN_CRON=*/30 * * * *
# 扫描根目录 ID；留空=全盘。测试时建议先填一个小目录
SCAN_ROOT_ID=

# ============================================================
# 【高级 · 普通用户请忽略】以下以 # 开头，全部是注释，不填任何东西。
# 光鸭凭证已由管理页「手机号+短信验证码」一键登录自动获取并加密保存，
# 不需要在这里填写，也不需要去光鸭开放平台申请应用或抓包。
#
# 只有“已有光鸭开放平台应用、想用官方 Device/PKCE 直连授权”的进阶用户，
# 才需要去掉对应行首的 # 并填写。详见 README 的高级说明。
# ============================================================
# GUANGYA_CLIENT_ID=
# GUANGYA_PROJECT_ID=
# GUANGYA_SIGN_SECRET=
# GUANGYA_DEVICE_ID=ya-tg
# GUANGYA_OAUTH_REDIRECT_URI=
# GUANGYA_API_BASE=https://openapi.guangyapan.com
# GUANGYA_ACCOUNT_BASE=https://openapi-account.guangyapan.com
# GUANGYA_WWW_BASE=https://www.guangyapan.com
# GUANGYA_SHARE_AUTHORIZATION=
# GUANGYA_SHARE_DID=
# GUANGYA_SHARE_DT=4
# GUANGYA_SHARE_SMID=
# GUANGYA_SHARE_BASE=https://api.guangyapan.com
#
# AI 辅助识别（可选）：推荐在管理页「TMDB 设置 → AI 辅助识别」配置，不用改这里。
# 支持 OpenAI / DeepSeek / Ollama / 各类中转等 OpenAI 兼容接口；不启用完全不影响使用。
# AI_ENABLED=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_PROMPT=
# AI_TIMEOUT=30
#
# Telegram API 地址（可选）：推荐在管理页「分发规则 → 链路自检」里填，不用改这里。
# 国内网络直连 api.telegram.org 常超时，可填自己可用的反向代理地址。
# TELEGRAM_API_BASE=https://api.telegram.org
