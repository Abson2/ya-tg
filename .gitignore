.env
__pycache__/
*.pyc
node_modules/
dist/
db/*
!db/.keep
logs/*
!logs/.keep
.pytest_cache/
*.db
*.db-journal
# SQLite 的 WAL / SHM 伴生文件（本地开发库运行时生成，同属本地数据，禁止入库）。
*.db-wal
*.db-shm
.DS_Store

# 浏览器抓包原始文件含登录凭证，禁止入库。
# 需要分享接口结构时，用 scripts/har_extract.py 生成脱敏摘要。
*.har
*.har.gz

# 源码包是发版产物，只作为 Release asset 发布，禁止入库。
# 历史版本已从仓库移除（v1.5.1 曾用 git add -A 误提交 9 个 zip）。
Ya-TG-*.zip

# v2.1.8 #241：Telegram MTProto 会话文件等同账号凭据（.session 承载登录态），
# 绝不入库；同时把本地数据目录整体排除。
# （凭据本身走 runtime_config → Fernet 加密落库，session 文件只落本地磁盘。）
*.session
data/

# WorkBuddy 本地项目数据（含 memory/automations 记忆文件），属工具侧产物，禁止入库。
.workbuddy/
